# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Phase 0 needs NONE of these. The scaffold, the scorer and the diagnostic
# script run entirely offline against a local sentence-transformers model.
# These are here for Phase 1+, when generation is introduced.

# Groq API key, used by the generation layer (Phase 1+).
# On Kaggle this comes from Add-ons > Secrets, not from a .env file.
GROQ_API_KEY=

# Optional: override the local embedding model used by the diagnostic script
# and the groundedness proxy.
PROCTORIQ_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
